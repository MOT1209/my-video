{
  "tasks": {
    "build": {
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "BLOB_READ_WRITE_TOKEN",
        "BLOB_STORE_ID",
        "BLOB_WEBHOOK_PUBLIC_KEY"
      ]
    },
    "create-snapshot": {
      "env": [
        "BLOB_READ_WRITE_TOKEN",
        "BLOB_STORE_ID",
        "BLOB_WEBHOOK_PUBLIC_KEY"
      ],
      "passThroughEnv": [
        "VERCEL_DEPLOYMENT_ID",
        "VERCEL_OIDC_TOKEN",
        "VERCEL_TEAM_ID",
        "VERCEL_PROJECT_ID"
      ],
      "cache": false
    }
  },
  "dangerouslyDisablePackageManagerCheck": true
}
