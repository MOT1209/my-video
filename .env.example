# متغيرات البيئة المطلوبة (الخادم فقط — لا تُكشف للعميل)
# انسخ هذا الملف إلى .env.local واملأ القيم.

# ── Vercel Blob (مطلوب للتصيير والصوت وصور الخلفيات) ─────────
# من Vercel Dashboard → Storage → Create Database → Blob
BLOB_READ_WRITE_TOKEN=

# ── Upstash Redis (مطلوب في الإنتاج: حد المعدل والقفل الموزّعان) ──
# من console.upstash.com → قاعدة Redis → REST API
# محلياً: بدونها يعمل التطبيق بحدود في الذاكرة (يكفي للتطوير).
# في الإنتاج: بدونها (أو عند تعطّلها) تُغلق المسارات المكلفة 503.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# true = اقبل عدّاد الذاكرة في الإنتاج (لكل نسخة على حدة — لا يحمي التكلفة)
RATE_LIMIT_ALLOW_IN_MEMORY=

# ── Gemini (اختياري: السكربت + صور الخلفيات AI) ──────────────
# من aistudio.google.com → Get API key (مفتاح واحد يخدم الاثنين)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# ── Azure Speech (اختياري: fallback للصوت بعد فشل Edge-TTS) ──
# من portal.azure.com → Speech Service → Keys & Endpoint
# بدونها يبقى Edge-TTS المجاني هو المُستخدم
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── Neon Postgres (مطلوب لميزات الحساب وللتصيير في الإنتاج) ──
# من console.neon.tech → مشروع → Connection string
# بدونها تعمل ميزات SaaS معطّلة برسائل 503 إرشادية، ويُرفض التصيير في
# الإنتاج 503 (لا تصيير بلا فرض كريدت) إلا مع ALLOW_ANONYMOUS_PAID_ROUTES=true
DATABASE_URL=
# بعد ضبطها طبّق الهجرات (وبعد كل ترقية): npx drizzle-kit migrate

# ── Clerk (مطلوب لحماية /api/render بالمصادقة) ───────────────────
# من dashboard.clerk.com → API Keys
# بدونهما يعمل /api/render مفتوحاً لأي زائر (وضع محلي فقط — خطر تكلفة في الإنتاج)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Stripe (مطلوب لبيع حزم الكريدت) ──────────────────────────────
# من dashboard.stripe.com → Developers → API keys + Webhooks
# الـ webhook يشير إلى /api/billing/webhook (يفشل الطلب بأمان عند غياب التوقيع)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── طابور إعادة التصيير (يُشغَّل من GitHub Actions، انظر README) ──────────────────────
# قيمة عشوائية طويلة تُطابق Authorization: Bearer (يُضاف أيضاً كسرّ CRON_SECRET في GitHub Actions)
CRON_SECRET=
# ── فتح المسارات المكلفة عمداً (اختياري، بحذر) ───────────────────
# في الإنتاج بلا Clerk تُغلق /api/render و/api/script و/api/image و/api/tts
# و/api/transcribe (503). true = افتحها لأي زائر، ويسمح كذلك بالتصيير بلا
# DATABASE_URL (بلا فرض كريدت). لأداة شخصية فقط، ومع Upstash على الأقل.
ALLOW_ANONYMOUS_PAID_ROUTES=

# أصل التطبيق العام (مثل https://my-video.example.com). اختياري: يُضاف لقائمة
# الأصول المسموحة لروابط العودة من Stripe إلى جانب أصل الطلب وروابط Vercel.
APP_URL=

# أقصى عدد حسابات جديدة تأخذ كريدت الترحيب المجاني من نفس IP كل 24 ساعة
# (الافتراضي 3). ما فوقه يُنشأ برصيد 0 ويستطيع الشراء. 0 = لا كريدت مجاني.
SIGNUP_FREE_PER_IP_PER_DAY=

# ── سقف تكلفة التصيير اليومي (اختياري) ─────────────────────────────
# مجموع دقائق sandbox المسموحة للخدمة كلها في آخر 24 ساعة. عند بلوغه يُرفض
# التصيير الجديد 503 بلا خصم كريدت (الناتج المخزّن في الكاش لا يتأثر).
# اتركه فارغاً لتعطيل السقف.
RENDER_DAILY_SANDBOX_MINUTES=

# ── تنظيف snapshots القديمة (بناء الإنتاج فقط) ──────────────────────
# عدد snapshots Vercel Sandbox المحتفَظ بها (الأحدث). كل نشر ينشئ واحدة بلا
# انتهاء صلاحية وتستنفد حصة Hobby إن تراكمت. الافتراضي 3.
SNAPSHOTS_TO_KEEP=
